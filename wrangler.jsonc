{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hightide-landing",
  "account_id": "453037e3b1f29deea4eab0f0313c7ab2",
  "compatibility_date": "2026-07-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./_site"
