---
layout: layouts/base.njk
title: Hightide Video Tutorials | Learn the Platform
description: Watch step-by-step Hightide tutorials to set up your account, manage bookings and run day-to-day operations with confidence.
permalink: /video-tutorials/
bodyClass: page-tutorials
---

<section class="page-header tutorials-hero">
  <div class="container">
    <h1>Video Tutorials</h1>
    <p class="section-lead">Set up Hightide, manage individual bookings and run the wider operation.</p>
  </div>
</section>

<section class="section tutorials-intro">
  <div class="container tutorials-intro-inner">
    <p class="tutorials-intro-eyebrow">{{ videoTutorials.intro.eyebrow }}</p>
    <h2>{{ videoTutorials.intro.title }}</h2>
    <p class="tutorials-intro-copy">{{ videoTutorials.intro.description }}</p>
    <div class="video-embed tutorials-intro-video">
      <iframe
        src="{{ videoTutorials.intro.embedUrl }}"
        title="{{ videoTutorials.intro.videoTitle }}"
        loading="eager"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<section class="section section-alt tutorials-categories">
  <div class="container">
    {% if videoTutorials.videoCount >= videoTutorials.searchThreshold %}
    <form class="tutorials-search" role="search" data-tutorials-search>
      <label class="visually-hidden" for="tutorials-search-input">Search tutorials</label>
      <input
        id="tutorials-search-input"
        type="search"
        name="q"
        placeholder="Search tutorials, for example cancel booking"
        autocomplete="off"
        data-tutorials-search-input
      >
    </form>
    {% endif %}

    <div class="tutorials-category-grid">
      {% for category in videoTutorials.categories %}
      <article
        class="tutorials-category-card"
        data-tutorials-category
        data-search-text="{{ category.title }} {{ category.description }} {{ category.examples | join(' ') }} {{ category.topics | join(' ') }}"
      >
        <h2>{{ category.title }}</h2>
        <p class="tutorials-category-desc">{{ category.description }}</p>
        <p class="tutorials-category-count">
          {% if category.videos.length == 1 %}
          1 tutorial
          {% else %}
          {{ category.videos.length }} tutorials
          {% endif %}
        </p>
        <ul class="tutorials-category-examples">
          {% for example in category.examples %}
          <li>{{ example }}</li>
          {% endfor %}
        </ul>
        <a class="tutorials-category-link" href="/video-tutorials/{{ category.slug }}/">View tutorials →</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta-band">
      <h2>Prefer reading?</h2>
      <p>Check out our blog for written guides and best practices.</p>
      <a class="btn btn-secondary" href="/blog/" style="margin-top:1rem">Visit the Blog</a>
    </div>
  </div>
</section>
