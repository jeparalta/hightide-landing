---
layout: layouts/explore.njk
title: Booking Software for Camps, Retreats & Tours | Hightide
description: Sell accommodation, activities and packages online. Manage bookings, payments and operations in one place — no commission on Online Store bookings.
permalink: /
bodyClass: page-explore
---

{% macro sellStoryCard(card) %}
<article class="explore-sell-story-card explore-callout-carousel-item">
  <h3>{{ card.title }}</h3>
  <p>{{ card.text }}</p>
</article>
{% endmacro %}

{% macro manageCapabilityList(capabilities) %}
<ul class="explore-manage-capabilities">
  {% for item in capabilities %}
  <li>{{ item }}</li>
  {% endfor %}
</ul>
{% endmacro %}

{% macro manageProductHeading(product) %}
<div class="explore-manage-product-heading">
  <img
    src="{{ product.icon }}"
    alt="{{ product.title }}"
    class="explore-manage-product-icon{% if product.iconClass %} {{ product.iconClass }}{% endif %}"
    loading="lazy"
    width="48"
    height="48"
  >
  <h3 class="explore-manage-product-title">{{ product.title }}</h3>
</div>
{% endmacro %}

{% macro manageProductArea(product) %}
<article class="explore-manage-product">
  <button
    type="button"
    class="explore-manage-product-shot-btn"
    data-montage-open
    aria-label="View {{ product.alt }} in full size"
  >
    <img
      class="explore-manage-product-shot"
      src="{{ product.src }}"
      alt="{{ product.alt }}"
      loading="lazy"
      width="1600"
      height="1000"
    >
  </button>
  {{ manageProductHeading(product) }}
  <p class="explore-manage-product-description">{{ product.text }}</p>
  {{ manageCapabilityList(product.capabilities) }}
</article>
{% endmacro %}

{% macro integrationGroup(group) %}
<article class="explore-integration-group explore-integration-orbit-card{% if group.layout %} is-{{ group.layout }}{% endif %}{% if group.wide %} is-wide-card{% endif %}" data-integration-card>
  <h3>{{ group.title }}</h3>
  <ul{% if group.columns == 2 %} class="explore-integration-list-columns"{% endif %}>
    {% for item in group.items %}
    <li class="explore-integration-entry{% if item.logoOnly %} explore-integration-entry-logo-only{% endif %}">
      {% if item.logo %}
      <img
        src="{{ item.logo }}"
        alt="{{ item.name }}"
        class="explore-integration-logo{% if item.logoOnly %} explore-integration-logo-only{% endif %}"
        loading="lazy"
        width="72"
        height="20"
      >
      {% elif item.faIcon %}
      <span class="explore-integration-fa-icon" aria-hidden="true"><i class="{{ item.faIcon }}"></i></span>
      {% elif item.icon %}
      <img src="{{ item.icon }}" alt="{{ item.name }}" class="explore-integration-icon" loading="lazy" width="28" height="28">
      {% endif %}
      {% if not item.logoOnly %}
      <span{% if item.muted %} class="explore-integration-more"{% endif %}>{{ item.name }}</span>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</article>
{% endmacro %}

{% macro integrationMobileCardLabel(title) %}
<h3 class="explore-integrations-mobile-label">{{ title }}</h3>
{% endmacro %}

{% macro integrationMobileBentoChannel(group) %}
<article class="explore-integrations-mobile-card is-channel">
  {{ integrationMobileCardLabel(group.title) }}
  <ul class="explore-integrations-mobile-channel-grid">
    {% for item in group.items %}
      {% if item.name in ['Airbnb', 'Booking.com', 'Hostelworld', 'Expedia', 'Vrbo'] %}
      <li class="explore-integrations-mobile-channel-item">
        <img src="{{ item.logo }}" alt="{{ item.name }}" class="explore-integrations-mobile-channel-logo" loading="lazy" width="72" height="20">
        <span>{{ item.name }}</span>
      </li>
      {% elif item.muted %}
      <li class="explore-integrations-mobile-channel-item is-more">
        <span>+ more</span>
      </li>
      {% endif %}
    {% endfor %}
  </ul>
</article>
{% endmacro %}

{% macro integrationMobileBentoStack(group, showNames, modifier) %}
<article class="explore-integrations-mobile-card is-stack{% if modifier %} is-{{ modifier }}{% endif %}">
  {{ integrationMobileCardLabel(group.title) }}
  <ul class="explore-integrations-mobile-stack">
    {% for item in group.items %}
    <li class="explore-integrations-mobile-stack-item">
      <img
        src="{{ item.logo }}"
        alt="{{ item.name }}"
        class="explore-integrations-mobile-stack-logo{% if modifier == 'payments' %} is-payment{% if item.name == 'Stripe' %} is-stripe{% endif %}{% endif %}"
        loading="lazy"
        width="72"
        height="20"
      >
      {% if showNames %}
      <span class="explore-integrations-mobile-stack-name">{{ item.name }}</span>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</article>
{% endmacro %}

{% macro integrationMobileBentoPartners(group) %}
<article class="explore-integrations-mobile-card is-partners">
  {{ integrationMobileCardLabel(group.title) }}
  <ul class="explore-integrations-mobile-checklist">
    {% for item in group.items %}
    <li class="explore-integrations-mobile-checklist-item">
      <span class="explore-integrations-mobile-check" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
      <span>{{ item.name }}</span>
    </li>
    {% endfor %}
  </ul>
</article>
{% endmacro %}

{% macro integrationMobileBentoAnalytics(group) %}
<article class="explore-integrations-mobile-card is-analytics">
  {{ integrationMobileCardLabel(group.title) }}
  <ul class="explore-integrations-mobile-named-inline">
    {% for item in group.items %}
    <li class="explore-integrations-mobile-named-inline-item">
      <img
        src="{{ item.logo }}"
        alt="{{ item.name }}"
        class="explore-integrations-mobile-named-inline-logo"
        loading="lazy"
        width="72"
        height="20"
      >
      <span>{{ item.name }}</span>
    </li>
    {% endfor %}
  </ul>
</article>
{% endmacro %}

{% macro industryCard(card, industry) %}
{% set cardTitle = card.name or industry.cardName or industry.name %}
{% set cardHref = card.href or ('/explore/industries/' ~ industry.slug ~ '/') %}
{% set cardTeaser = card.cardTeaser or industry.cardTeaser %}
{% set cardImage = card.image or industry.image %}
{% set cardImageAlt = card.imageAlt or industry.imageAlt %}
{% set cardFeatured = industry.featured %}
{% set cardAriaLabel = card.ariaLabel or ('Explore Hightide for ' ~ cardTitle) %}
<a
  href="{{ cardHref }}"
  class="explore-industry-card{% if cardFeatured %} explore-industry-card-featured{% endif %}"
  data-industry-card
  aria-label="{{ cardAriaLabel }}"
>
  <img
    src="{{ cardImage }}"
    alt="{{ cardImageAlt }}"
    class="explore-industry-card-image"
    loading="lazy"
    width="640"
    height="360"
  >
  <div class="explore-industry-card-body">
    <h3 class="explore-industry-card-heading">
      <span class="explore-industry-card-title">{{ cardTitle }}</span>
      <span class="explore-industry-card-arrow" aria-hidden="true">↗</span>
    </h3>
    <p>{{ cardTeaser }}</p>
  </div>
</a>
{% endmacro %}

{% macro proofStory(story) %}
<article
  class="explore-proof-card"
  data-proof-card
  data-proof-business="{{ story.business }}"
  data-proof-name="{{ story.name }}"
  data-proof-role="{{ story.role }}"
  {% if story.logo %}data-proof-logo="{{ story.logo }}" data-proof-logo-alt="{{ story.logoAlt or story.business }}"{% endif %}
  {% if story.websiteUrl %}data-proof-website="{{ story.websiteUrl }}"{% endif %}
>
  <div class="explore-proof-card-body">
    <header class="explore-proof-card-header">
      {% if story.logo %}
      {% if story.websiteUrl %}
      <a href="{{ story.websiteUrl }}" class="explore-proof-logo-link" target="_blank" rel="noopener noreferrer" aria-label="{{ story.logoAlt or story.business }}">
        <img src="{{ story.logo }}" alt="{{ story.logoAlt or story.business }}" class="explore-proof-logo" loading="lazy" width="80" height="80">
      </a>
      {% else %}
      <img src="{{ story.logo }}" alt="{{ story.logoAlt or story.business }}" class="explore-proof-logo" loading="lazy" width="80" height="80">
      {% endif %}
      {% endif %}
      <div class="explore-proof-card-heading">
        {% if story.websiteUrl %}
        <h3 class="explore-proof-title">
          <a href="{{ story.websiteUrl }}" target="_blank" rel="noopener noreferrer">{{ story.business }}</a>
        </h3>
        {% else %}
        <h3 class="explore-proof-title">{{ story.business }}</h3>
        {% endif %}
        {% if story.industry %}
        <span class="explore-proof-industry">{{ story.industry }}</span>
        {% endif %}
      </div>
    </header>
    <blockquote class="explore-proof-quote">
      <p data-proof-excerpt>{{ story.quote }}</p>
    </blockquote>
    <div class="explore-proof-read-more-slot">
      <button type="button" class="explore-proof-read-more" data-proof-read hidden aria-label="Read full review from {{ story.name }}">Read full review</button>
    </div>
    <div hidden data-proof-full>{{ story.quote }}</div>
  </div>
  <footer class="explore-proof-attribution">
    <cite>{{ story.name }}</cite>
    <span>{{ story.role }}</span>
  </footer>
</article>
{% endmacro %}

{% macro integrationLineArt(src, width, height, from, to, orbit, index, fixed, offsetX, offsetY) %}
<img
  class="explore-integration-line explore-integration-line-art"
  data-integration-line
  data-integration-index="{{ index }}"
  data-line-art="{{ src }}"
  data-line-art-width="{{ width }}"
  data-line-art-height="{{ height }}"
  data-line-art-from="{{ from }}"
  data-line-art-to="{{ to }}"
  data-orbit-x="{{ orbit.x }}"
  data-orbit-y="{{ orbit.y }}"
  {% if offsetX %}data-line-art-offset-x="{{ offsetX }}"{% endif %}
  {% if offsetY %}data-line-art-offset-y="{{ offsetY }}"{% endif %}
  {% if fixed %}
  data-line-art-fixed-left="{{ fixed.left }}"
  data-line-art-fixed-top="{{ fixed.top }}"
  data-line-art-fixed-width="{{ fixed.width }}"
  data-line-art-fixed-height="{{ fixed.height }}"
  data-line-art-fixed-rotate="{{ fixed.rotate | default(0) }}"
  {% endif %}
  src="{{ src }}"
  alt="Integration connector"
  role="presentation"
  aria-hidden="true"
  decoding="async"
>
{% endmacro %}

{% set integrationOrbits = [
  { x: 32, y: 14 },
  { x: 81, y: 27 },
  { x: 86, y: 61 },
  { x: 50, y: 86 },
  { x: 14, y: 54 }
] %}

{% set integrationMobileChannel = exploreHome.integrations.groups[0] %}
{% set integrationMobilePayments = exploreHome.integrations.groups[1] %}
{% set integrationMobileInvoicing = exploreHome.integrations.groups[2] %}
{% set integrationMobileAnalytics = exploreHome.integrations.groups[3] %}
{% set integrationMobilePartners = exploreHome.integrations.groups[4] %}

<section class="explore-hero">
  <div class="explore-hero-stage">
    <div class="container explore-hero-content">
      <p class="explore-eyebrow">{{ explore.heroEyebrow }}</p>
      <h1 class="explore-hero-title">
        <span class="explore-hero-title-stack">
          <span class="explore-hero-title-line">
            <span class="explore-hero-title-main">Sell your</span><span class="explore-hero-rotate" data-hero-rotate aria-live="polite">
              <span class="explore-hero-rotate-sizer" aria-hidden="true">packages</span>
              {% for word in explore.heroRotateWords %}
              <span class="explore-hero-rotate-word{% if loop.first %} is-active{% endif %}">{{ word }}</span>
              {% endfor %}
            </span>
          </span>
          <span class="explore-hero-title-sub">Manage everything<br class="explore-br-mobile" aria-hidden="true"> together.</span>
        </span>
      </h1>
      <p class="explore-hero-lead">{{ explore.heroLead }}</p>
      <div class="explore-hero-cta-row">
        <span class="explore-hero-deco explore-hero-deco-sun" aria-hidden="true"></span>
        <div class="explore-hero-actions">
          <a class="btn btn-primary" href="{{ explore.primaryCtaUrl }}" data-ga-event="discovery_call_cta_click" data-ga-location="hero">{{ explore.primaryCtaLabel }}</a>
        </div>
        <span class="explore-hero-deco explore-hero-deco-moon" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt explore-story explore-story-sell" id="online-store">
  <div class="explore-sell-scroll-stage" data-callout-scroll>
    <div class="explore-sell-scroll-pin">
      <div class="container explore-sell-scroll-inner">
        <div class="explore-sell-scroll-intro">
          <h2 class="section-title">{{ exploreHome.sell.titleLine1 }}<br class="explore-br-mobile" aria-hidden="true"> {{ exploreHome.sell.titleLine2 }}</h2>
          <p class="section-lead">{{ exploreHome.sell.lead }}</p>
        </div>

        <div class="explore-sell-montage-wrap">
        <div class="explore-sell-media" data-sell-media>
        <div class="explore-sell-montage">
          {% for image in exploreHome.sell.images %}
          <button
            type="button"
            class="explore-sell-shot-wrap explore-sell-shot-wrap-{{ loop.index }}"
            data-montage-open
            aria-label="View {{ image.alt }} in full size"
          >
            <img
              class="explore-sell-shot explore-sell-shot-{{ loop.index }}"
              src="{{ image.src }}"
              alt="{{ image.alt }}"
              loading="lazy"
              width="800"
              height="480"
            >
          </button>
          {% endfor %}
        </div>
        <div class="explore-sell-video-clip">
          <video
            class="explore-sell-video"
            data-sell-video
            muted
            loop
            playsinline
            webkit-playsinline
            preload="auto"
            aria-label="A short demonstration of the Hightide Online Store booking process"
          >
            <source
              src="/assets/videos/online-store-tour.mp4"
              type="video/mp4"
            >
          </video>
        </div>
        <span
          class="explore-sell-video-start"
          data-sell-video-start
          aria-hidden="true"
        ></span>
        </div>
        <a
          class="btn btn-primary explore-sell-demo-btn"
          href="{{ explore.demoStoreUrl }}"
          target="_blank"
          rel="noopener noreferrer"
          data-ga-event="demo_store_click"
          data-ga-location="online_store"
        >{{ exploreHome.sell.demoStore.label }}</a>
        </div>

        <div class="explore-sell-story" data-callout-story>
          <div
            class="explore-sell-story-progress"
            role="progressbar"
            aria-label="Online store story progress"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            data-callout-progress-wrap
          >
            <span class="explore-sell-story-progress-bar" data-callout-progress></span>
          </div>
          <div
            class="explore-callout-carousel"
            data-callout-carousel
            tabindex="0"
            role="region"
            aria-label="Online store features"
          >
            <div class="explore-callout-track" data-callout-track>
              {% for card in exploreHome.sell.storyCards %}
              {{ sellStoryCard(card) }}
              {% endfor %}
            </div>
          </div>
          <div class="explore-callout-carousel-controls" data-callout-controls hidden>
            <button
              type="button"
              class="explore-callout-carousel-btn"
              data-callout-prev
              aria-label="Previous feature"
              disabled
            >
              <span aria-hidden="true">&larr;</span>
            </button>
            <p class="explore-callout-carousel-status" data-callout-status aria-live="polite"></p>
            <button
              type="button"
              class="explore-callout-carousel-btn"
              data-callout-next
              aria-label="Next feature"
            >
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        </div>

        <div class="explore-sell-tools" data-callout-tools>
          <p class="explore-sell-tools-label">{{ exploreHome.sell.toolsLabel }}</p>
          <div class="explore-tool-band" aria-label="Supported integrations for selling online">
          {% for tool in exploreHome.sell.tools %}
          <span class="explore-tool-item{% if tool.logoOnly %} explore-tool-item-logo-only{% endif %}">
            <img
              src="{{ tool.logo }}"
              alt="{{ tool.name }}"
              class="explore-tool-logo{% if tool.logoOnly %} explore-tool-logo-only{% endif %}"
              loading="lazy"
              width="72"
              height="20"
            >
            {% if not tool.logoOnly %}
            <span>{{ tool.name }}</span>
            {% endif %}
          </span>
          {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section explore-story explore-story-manage">
  <div class="explore-manage-scroll-stage is-static" data-manage-scroll>
    <div class="explore-manage-scroll-pin">
      <div class="container explore-manage-scroll-inner">
        <div class="explore-manage-scroll-intro">
          <h2 class="section-title">{{ exploreHome.manage.title }}</h2>
          <p class="section-lead">{{ exploreHome.manage.lead }}</p>
        </div>

        <div class="explore-manage-desktop-layout">
          <div class="explore-manage-products" data-manage-products>
            {% for product in exploreHome.manage.products %}
            {{ manageProductArea(product) }}
            {% endfor %}
          </div>
        </div>

        <div class="explore-manage-mobile-layout" data-manage-showcase>
          <div
            class="explore-manage-showcase-tabs"
            role="tablist"
            aria-label="Product views"
            data-manage-showcase-tabs
          >
            {% for product in exploreHome.manage.products %}
            <button
              type="button"
              class="explore-manage-showcase-tab"
              role="tab"
              id="manage-showcase-tab-{{ loop.index0 }}"
              aria-controls="manage-showcase-slide-{{ loop.index0 }}"
              aria-selected="{% if loop.first %}true{% else %}false{% endif %}"
              tabindex="{% if loop.first %}0{% else %}-1{% endif %}"
              data-manage-showcase-tab
              data-index="{{ loop.index0 }}"
            >
              {{ product.tabLabel }}
            </button>
            {% endfor %}
          </div>

          <div
            class="explore-manage-showcase-carousel"
            data-manage-showcase-carousel
            tabindex="0"
            role="region"
            aria-roledescription="carousel"
            aria-label="Manage product screenshots"
          >
            <div class="explore-manage-showcase-track" data-manage-showcase-track>
              {% for product in exploreHome.manage.products %}
              <div
                class="explore-manage-showcase-slide"
                id="manage-showcase-slide-{{ loop.index0 }}"
                role="tabpanel"
                aria-labelledby="manage-showcase-tab-{{ loop.index0 }}"
                data-manage-showcase-slide
                aria-hidden="{% if loop.first %}false{% else %}true{% endif %}"
              >
                <button
                  type="button"
                  class="explore-manage-product-shot-btn"
                  data-montage-open
                  aria-label="View {{ product.alt }} in full size"
                >
                  <img
                    class="explore-manage-product-shot"
                    src="{{ product.src }}"
                    alt="{{ product.alt }}"
                    loading="lazy"
                    width="1600"
                    height="1000"
                  >
                </button>
                <div class="explore-manage-showcase-detail">
                  {{ manageProductHeading(product) }}
                  <p class="explore-manage-product-description">{{ product.text }}</p>
                  {{ manageCapabilityList(product.capabilities) }}
                </div>
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt explore-story explore-story-integrations">
  <div class="explore-integrations-scroll-stage" data-integrations-scroll>
    <div class="explore-integrations-scroll-pin">
      <div class="container explore-integrations-scroll-inner">
        <div class="explore-integrations-scroll-intro">
          <h2 class="section-title">{{ exploreHome.integrations.title }}</h2>
          <p class="section-lead">{{ exploreHome.integrations.lead }}</p>
        </div>

        <div class="explore-integrations-hub" data-integrations-hub>
          <div class="explore-integrations-line-art-layer" aria-hidden="true">
            {{ integrationLineArt("/assets/images/integrations/connectors/channel-manager-arrow.png?v=3", 235, 307, "br", "tl", integrationOrbits[0], 0) }}
            {{ integrationLineArt("/assets/images/integrations/connectors/payments-arrow.png?v=3", 284, 200, "bl", "tr", integrationOrbits[1], 1) }}
            {{ integrationLineArt("/assets/images/integrations/connectors/invoicing-arrow-v2.png", 350, 135, "tl", "br", integrationOrbits[2], 2) }}
            {{ integrationLineArt("/assets/images/integrations/connectors/analytics-arrow-v5.png?v=3", 64, 304, "tl", "bl", integrationOrbits[3], 3, null, -10) }}
            {{ integrationLineArt("/assets/images/integrations/connectors/partners-arrow.png?v=3", 480, 108, "tr", "tl", integrationOrbits[4], 4) }}
          </div>
          <div class="explore-integrations-logo" aria-hidden="true">
            <img src="/assets/images/logo.svg" alt="Hightide" width="72" height="72" loading="lazy" decoding="async">
          </div>
          {% for group in exploreHome.integrations.groups %}
          <div
            class="explore-integration-orbit-slot"
            data-integration-slot
            data-orbit-x="{{ integrationOrbits[loop.index0].x }}"
            data-orbit-y="{{ integrationOrbits[loop.index0].y }}"
          >
            {{ integrationGroup(group) }}
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="explore-integrations-mobile">
    <div class="container explore-integrations-mobile-inner">
      <div class="explore-integrations-mobile-intro">
        <h2 class="section-title">{{ exploreHome.integrations.title }}</h2>
        <p class="section-lead">{{ exploreHome.integrations.lead }}</p>
      </div>

      <div class="explore-integrations-mobile-bento">
        {{ integrationMobileBentoChannel(integrationMobileChannel) }}
        {{ integrationMobileBentoStack(integrationMobilePayments, false, 'payments') }}
        {{ integrationMobileBentoStack(integrationMobileInvoicing, true, 'invoicing') }}
        {{ integrationMobileBentoPartners(integrationMobilePartners) }}
        {{ integrationMobileBentoAnalytics(integrationMobileAnalytics) }}
      </div>
    </div>
  </div>
</section>

<section class="section explore-industries-section">
  <div class="container">
    <h2 class="section-title">{{ exploreHome.industries.title }}</h2>
    <p class="section-lead">{{ exploreHome.industries.lead }}</p>
    <div class="explore-industry-grid" data-industry-cards>
      {% for card in exploreHome.industries.homeCards %}
      {% if card.href %}
      {{ industryCard(card, card) }}
      {% else %}
      {% for industry in exploreIndustries %}
      {% if industry.slug == card.slug %}
      {{ industryCard(card, industry) }}
      {% endif %}
      {% endfor %}
      {% endif %}
      {% endfor %}
    </div>
    {% if exploreHome.industries.badges and exploreHome.industries.badges.length %}
    <div class="explore-industry-badges">
      <h3 class="explore-industry-badges-heading">{{ exploreHome.industries.badgesHeading }}</h3>
      <ul class="explore-industry-badge-list">
        {% for badge in exploreHome.industries.badges %}
        {% for industry in exploreIndustries %}
        {% if industry.slug == badge.slug %}
        <li>
          <a
            class="explore-industry-badge"
            href="/explore/industries/{{ industry.slug }}/"
          >{{ industry.name }}</a>
        </li>
        {% endif %}
        {% endfor %}
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
</section>

<section class="section explore-story-proof">
  <div class="container">
    <h2 class="section-title">{{ exploreHome.testimonials.title }}</h2>
    <div class="explore-proof-carousel" data-proof-carousel>
      <div
        class="explore-proof-carousel-viewport"
        data-proof-viewport
        tabindex="0"
        role="region"
        aria-label="Customer testimonials"
      >
        <div class="explore-proof-carousel-track" data-proof-track>
          {% for story in exploreHome.testimonials.stories %}
          {{ proofStory(story) }}
          {% endfor %}
        </div>
      </div>
