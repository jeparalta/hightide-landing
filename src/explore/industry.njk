---
layout: layouts/explore.njk
pagination:
  data: exploreIndustries
  size: 1
  alias: industry
permalink: "/explore/industries/{{ industry.slug }}/"
eleventyExcludeFromCollections: true
bodyClass: page-explore
---

{% set page = exploreIndustryPages[industry.slug] %}
{% if page and industry.tier == "lightweight" %}
{% include "partials/explore-industry-page-lite.njk" %}
{% elif page %}
{% include "partials/explore-industry-page.njk" %}
{% else %}
<section class="section">
  <div class="container">
    <h1>{{ industry.name }}</h1>
    <p class="section-lead" style="text-align:left">This industry page is not available yet.</p>
    <p><a href="/explore/industries/">View all industries</a></p>
  </div>
</section>
{% endif %}
