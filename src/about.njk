---
layout: layouts/base.njk
title: About Hightide | Built for Independent Operators
description: Learn why Hightide was built for surf camps, retreats and tour operators — and how we help independent businesses grow on their own terms.
permalink: /about/
bodyClass: page-about
---

<section class="about-hero section">
  <div class="container about-hero-inner">
    <div class="about-hero-copy">
      <h1>{{ aboutPage.hero.title }}</h1>
      <p class="section-lead">{{ aboutPage.hero.lead }}</p>
      {% for paragraph in aboutPage.hero.paragraphs %}
      <p>{{ paragraph }}</p>
      {% endfor %}
    </div>
    <div class="about-hero-media">
      <img
        src="{{ aboutPage.hero.image }}"
        alt="{{ aboutPage.hero.imageAlt }}"
        loading="eager"
        width="640"
        height="520"
      >
    </div>
  </div>
</section>

<section class="about-surfpreneurs-story" aria-labelledby="about-surfpreneurs-heading">
  <div class="about-surfpreneurs-story-inner">
    <p class="about-surfpreneurs-story-eyebrow">{{ surfpreneursFeature.about.eyebrow }}</p>
    <h2 id="about-surfpreneurs-heading">{{ surfpreneursFeature.about.heading }}</h2>
    <p>{{ surfpreneursFeature.about.copy }}</p>
  </div>
</section>

{% set surfpreneursCta = surfpreneursFeature.about.cta %}
{% include "partials/surfpreneurs-feature.njk" %}

<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">{{ aboutPage.team.title }}</h2>
    <p class="section-lead">{{ aboutPage.team.lead }}</p>
    <div class="team-grid">
      {% for member in aboutPage.team.members %}
      <article class="team-card">
        <img src="{{ member.image }}" alt="{{ member.name }}" loading="lazy" width="160" height="160">
        <h3>{{ member.name }}</h3>
        {% if member.role %}
        <p class="team-card-role">{{ member.role }}</p>
        {% endif %}
        <p>{{ member.bio }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container about-mission">
    <h2 class="section-title">{{ aboutPage.mission.title }}</h2>
    {% for item in aboutPage.mission.items %}
    <div class="about-mission-item">
      <h3>{{ item.title }}</h3>
      <p>{{ item.text }}</p>
    </div>
    {% endfor %}
    <p class="about-mission-closing">{{ aboutPage.mission.closing }}</p>
  </div>
</section>

{% include "partials/explore-cta.njk" %}
