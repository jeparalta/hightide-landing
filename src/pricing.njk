---
layout: layouts/base.njk
title: Hightide Pricing | Booking Software for Surf Camps, Retreats & Tours
description: Simple pricing for Hightide’s complete booking and operations platform. Choose the capacity that fits your business. No commission on direct bookings.
permalink: /pricing/
bodyClass: page-pricing
---

<section class="pricing-hero">
  <div class="container">
    <h1>{{ pricingPage.hero.title }}</h1>
    <p class="pricing-hero-lead">{{ pricingPage.hero.lead }}</p>
    <div class="pricing-toggle" role="group" aria-label="Billing period">
      <button type="button" data-period="monthly" class="active">Monthly</button>
      <button type="button" data-period="yearly">Annual</button>
    </div>
    <p class="pricing-annual-note">{{ pricingPage.hero.annualNote }}</p>
  </div>
</section>

<section class="section pricing-plans">
  <div class="container">
    <div class="pricing-grid">
      {% for plan in pricingPage.plans %}
      <article class="pricing-card{% if plan.featured %} featured{% endif %}">
        {% if plan.badge %}
        <p class="pricing-badge">{{ plan.badge }}</p>
        {% endif %}
        <h2>{{ plan.name }}</h2>
        <p class="pricing-card-desc">{{ plan.description }}</p>
        <p class="price" data-price-monthly>{{ plan.monthly }} <span>/ month</span></p>
        <p class="price" data-price-yearly hidden>{{ plan.yearly }} <span>/ month</span></p>
        <p class="pricing-billed" data-price-yearly hidden>billed annually</p>
        <p class="pricing-billed pricing-billed-placeholder" data-price-monthly aria-hidden="true">&nbsp;</p>
        <ul class="pricing-meta">
          <li>{{ plan.capacity }}</li>
          <li>{{ plan.team }}</li>
        </ul>
        <ul class="pricing-features">
          {% for feature in plan.features %}
          <li>{{ feature }}</li>
          {% endfor %}
        </ul>
        <div class="pricing-card-actions">
          <a class="btn btn-primary" href="{{ explore.primaryCtaUrl }}" data-ga-event="discovery_call_cta_click" data-ga-location="pricing_card">Book a Discovery Call</a>
          <a class="btn btn-secondary" href="{{ site.signupUrl }}" data-ga-event="free_trial_click" data-ga-location="pricing_card">Start a Free Trial</a>
          <p class="pricing-trial-note">{{ pricingPage.trialNote }}</p>
        </div>
      </article>
      {% endfor %}
    </div>

    <div class="pricing-units">
      <h2>{{ pricingPage.units.title }}</h2>
      <p>{{ pricingPage.units.copy }}</p>
    </div>
  </div>
</section>

<section class="section section-alt pricing-platform">
  <div class="container">
    <h2 class="section-title">{{ pricingPage.platform.title }}</h2>
    <p class="section-lead">{{ pricingPage.platform.lead }}</p>
    <div class="pricing-platform-grid">
      {% for group in pricingPage.platform.groups %}
      <div class="pricing-platform-group">
        <h3>{{ group.title }}</h3>
        <ul>
          {% for feature in group.features %}
          <li>{{ feature }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section pricing-onboarding">
  <div class="container">
    <h2 class="section-title">{{ pricingPage.onboarding.title }}</h2>
    <p class="section-lead">{{ pricingPage.onboarding.copy }}</p>
    <ol class="pricing-onboarding-steps">
      {% for step in pricingPage.onboarding.steps %}
      <li>
        <span class="pricing-onboarding-step-num" aria-hidden="true">{{ loop.index }}</span>
        <h3>{{ step.title }}</h3>
        <p>{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="section section-alt pricing-addons">
  <div class="container">
    <h2 class="section-title">{{ pricingPage.addons.title }}</h2>
    <div class="addons-grid">
      {% for item in pricingPage.addons.items %}
      <article class="addon-card">
        <h3>{{ item.title }}</h3>
        <p>{{ item.description }}</p>
        <p class="price addon-price" data-price-monthly>{{ item.monthly }} <span>{{ item.periodLabel }}</span></p>
        <p class="price addon-price" data-price-yearly hidden>{{ item.yearly }} <span>{{ item.periodLabel }}</span></p>
        <p class="pricing-billed" data-price-yearly hidden>billed annually</p>
      </article>
      {% endfor %}
    </div>
    <p class="pricing-vat-note">{{ pricingPage.vatNote }}</p>
  </div>
</section>

<section class="section pricing-complex">
  <div class="container">
    <div class="pricing-complex-inner">
      <h2>{{ pricingPage.complex.title }}</h2>
      <p>{{ pricingPage.complex.copy }}</p>
      <a class="btn btn-primary" href="{{ explore.primaryCtaUrl }}" data-ga-event="discovery_call_cta_click" data-ga-location="pricing_complex">Book a Discovery Call</a>
    </div>
  </div>
</section>

<section class="section section-faq pricing-faq">
  <div class="container">
    <h2 class="section-title">FAQ</h2>
    <div class="faq-list">
      {% for item in pricingPage.faq %}
      <details class="faq-item">
        <summary>{{ item.question }}</summary>
        <p>{{ item.answer }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

{% include "partials/explore-cta.njk" %}
